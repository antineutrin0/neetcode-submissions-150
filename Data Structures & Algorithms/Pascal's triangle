class Solution {
public:
    vector<vector<int>> generate(int numRows) {

        vector<vector<int>>res;

        res.push_back({1});
        numRows--;
        while(numRows--){
            int size=res.size();
            res.push_back({1});
            for(int i=0;i<res[size-1].size()-1;i++){
               res[size].push_back(res[size-1][i]+res[size-1][i+1]);
            }
            res[size].push_back(1);
        }

        return res;
        
    }
};
